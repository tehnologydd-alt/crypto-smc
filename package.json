    "android:run": "npm run android:sync && npx cap run android",
    "test": "node scripts/selftest.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "lucide-react": "^0.546.0",
